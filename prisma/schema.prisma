generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantRole {
  ADMIN
  BUILDER
  OPERATOR
  APPROVER
  VIEWER
}

enum AgentStatus {
  REGISTERED
  READY
  RUNNING
  WAITING
  PAUSED
  COMPLETED
  FAILED
}

enum WorkflowStatus {
  DRAFT
  READY
  PAUSED
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionStatus {
  CREATED
  AUTHORIZED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum ApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  CLAIMED
  PUBLISHED
  FAILED
  DEAD_LETTERED
}

model Tenant {
  id           String              @id
  slug         String              @unique
  name         String
  settings     Json                @default("{}")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  members      TenantMember[]
  agents       Agent[]
  tools        ToolDefinition[]
  workflows    Workflow[]
  executions   WorkflowExecution[]
  events       DomainEvent[]
  transactions Transaction[]
  approvals    HumanApproval[]
  outbox       OutboxMessage[]
  transcripts  Transcript[]
  mcpServers   McpServer[]
  orcfloRuns   OrcfloRun[]
  orcfloRunEvents OrcfloRunEvent[]
  orcfloStepCache  OrcfloStepCacheEntry[]
  orcfloMetering   OrcfloMeteringRecord[]
  orcfloDecisions  OrcfloDecisionRecord[]
  orcfloModelProviders OrcfloModelProvider[]
  orcfloTriggers    OrcfloTrigger[]
  orcfloBlueprints  OrcfloBlueprint[]
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  actorId   String
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, actorId])
  @@index([actorId])
}

model Agent {
  id           String      @id
  tenantId     String
  name         String
  description  String
  role         String
  status       AgentStatus @default(REGISTERED)
  goals        Json
  instructions String
  toolIds      Json
  capabilities Json
  permissions  Json
  policies     Json
  metadata     Json        @default("{}")
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
}

model ToolDefinition {
  id           String   @id
  tenantId     String
  name         String
  description  String
  inputSchema  Json
  permissions  Json
  riskLevel    String
  timeoutMs    Int
  cost         Json
  availability String
  // Capability 05 / 06 — tool provenance. `source` distinguishes built-in
  // from runtime-generated from MCP-bridged tools. `trusted` gates
  // generated / MCP tools through the existing `evaluateToolPolicy` path.
  source       String   @default("static")
  trusted      Boolean  @default(false)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, availability])
  @@index([tenantId, source, trusted])
}

model Workflow {
  id          String         @id
  tenantId    String
  name        String
  description String
  status      WorkflowStatus @default(DRAFT)
  version     Int            @default(1)
  nodes       Json
  edges       Json
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]
  orcfloRuns  OrcfloRun[]
  orcfloTriggers OrcfloTrigger[]

  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
}

model WorkflowExecution {
  id            String          @id
  tenantId      String
  workflowId    String
  status        ExecutionStatus @default(PENDING)
  input         Json
  output        Json?
  nodeResults   Json
  correlationId String
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow      Workflow        @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, workflowId, createdAt])
  @@index([correlationId])
}

model Transaction {
  id             String            @id
  tenantId       String
  agentId        String?
  type           String
  amountMinor    BigInt
  currency       String
  recipient      String
  status         TransactionStatus @default(CREATED)
  authorization  Json?
  idempotencyKey String
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  completedAt    DateTime?
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, agentId])
}

model HumanApproval {
  id           String         @id
  tenantId     String
  resourceType String
  resourceId   String
  status       ApprovalStatus @default(REQUESTED)
  requestedBy  String
  decidedBy    String?
  reason       String?
  metadata     Json           @default("{}")
  requestedAt  DateTime       @default(now())
  decidedAt    DateTime?
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, requestedAt])
  @@index([tenantId, resourceType, resourceId])
}

model DomainEvent {
  id            String         @id
  tenantId      String
  eventType     String
  schemaVersion Int            @default(1)
  occurredAt    DateTime       @default(now())
  actorId       String?
  correlationId String
  causationId   String?
  aggregateType String
  aggregateId   String
  payload       Json
  metadata      Json           @default("{}")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outbox        OutboxMessage?

  @@index([tenantId, eventType, occurredAt])
  @@index([tenantId, aggregateType, aggregateId, occurredAt])
  @@index([correlationId])
}

model OutboxMessage {
  id          String       @id
  tenantId    String
  eventId     String       @unique
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  publishedAt DateTime?
  lastError   String?
  // Audit §3 — claim/lease fields. A row in `CLAIMED` status is owned
  // by exactly one worker until the lease expires. Another worker may
  // reclaim after the expiry.
  claimedBy   String?
  claimedUntil DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event       DomainEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, availableAt])
  @@index([topic, status, availableAt])
  @@index([status, claimedUntil])
}

// Capability 04 — Multi-user transcriber (additive).
// Persists already-transcribed input lines with session/participant
// metadata. The associated audit event for a command still excludes
// raw text per `agent-command-service.ts`; this is a separate durable
// record for the UI, search, and analytics to re-derive text on demand.
model Transcript {
  id                  String   @id
  tenantId            String
  sessionId           String
  participantId       String
  occurredAt          DateTime @default(now())
  language            String   @default("en")
  text                String
  confidence          Float
  final               Boolean  @default(true)
  intent              String?
  riskLevel           String?
  requiresConfirmation Boolean?
  commandId           String?
  metadata            Json     @default("{}")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId, occurredAt])
  @@index([tenantId, participantId, occurredAt])
  @@index([tenantId, commandId])
}

// Capability 06 — MCP server allowlist. A row with `trusted = true`
// is the only kind `evaluateWorkflowNodePolicy` will allow at runtime.
model McpServer {
  id           String   @id
  tenantId     String
  name         String
  transport    String
  endpoint     String
  identityRef  String
  allowedTools Json     @default("[]")
  trusted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, trusted])
}

// === Orcflo engine (additive) ===
//
// Orcflo is the deterministic workflow run engine: `OrcfloRun` is the
// run aggregate, `OrcfloRunEvent` is the append-only run stream,
// `OrcfloStepCacheEntry` stores content-hashed step outputs,
// `OrcfloMeteringRecord` meters observable units, `OrcfloModelProvider`
// registers fail-closed model gateways, `OrcfloTrigger` holds the four
// trigger kinds, and `OrcfloBlueprint` stores reusable workflow
// templates. See docs/ARCHITECTURE.md §5.

model OrcfloRun {
  id            String   @id
  tenantId      String
  workflowId    String
  blueprintId   String?
  triggerId     String?
  triggerKind   String?
  status        String   @default("RUNNING")
  input         Json
  output        Json?
  stepResults   Json
  correlationId String
  // §48 idempotency — client/derived key; unique per tenant. NULL rows
  // (runs started without a key) are exempt via the partial unique index.
  idempotencyKey String?
  // Durable execution — caller context + bounds captured at creation so a
  // background worker can reconstruct the ActorContext and limits when the
  // run executes (policy, metering, events, resume).
  actorId       String?
  role          String?
  environment   String?
  limits        Json?
  // §49 resumable approval — the human decision for a run paused at
  // WAITING_APPROVAL (APPROVED triggers a resume; REJECTED cancels).
  approval      Json?
  // Multi-worker claim/lease (mirrors the outbox, Audit §3): a PENDING
  // run claimed by a worker carries claimedBy/claimedUntil; a worker may
  // reclaim rows whose lease has expired.
  claimedBy     String?
  claimedUntil  DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  events        OrcfloRunEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, workflowId, createdAt])
  @@index([tenantId, triggerId, createdAt])
  @@index([correlationId])
  @@index([status, claimedBy, claimedUntil])
}

model OrcfloRunEvent {
  id         String   @id
  tenantId   String
  runId      String
  sequence   Int
  eventType  String
  nodeId     String?
  status     String?
  payload    Json
  occurredAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run        OrcfloRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([tenantId, runId, sequence])
}

model OrcfloStepCacheEntry {
  id              String   @id
  tenantId        String
  key             String
  workflowId      String
  workflowVersion Int
  nodeId          String
  inputHash       String
  output          Json
  hits            Int      @default(0)
  createdAt       DateTime @default(now())
  lastHitAt       DateTime?
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, workflowId, nodeId])
}

model OrcfloMeteringRecord {
  id         String   @id
  tenantId   String
  runId      String?
  workflowId String?
  nodeId     String?
  metric     String
  unit       String
  amount     BigInt
  recordedAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, metric, recordedAt])
  @@index([tenantId, runId])
  @@index([tenantId, workflowId, recordedAt])
}

// Persisted control-node decisions (branch coverage / audit). One row per
// deterministic decision a condition / router / for_each node made during
// a run; result carries the decision value.
model OrcfloDecisionRecord {
  id         String   @id
  tenantId   String
  runId      String
  workflowId String
  nodeId     String
  kind       String
  subject    String
  result     Json
  iteration  Int      @default(0)
  occurredAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId, occurredAt])
  @@index([tenantId, workflowId, nodeId])
}

model OrcfloModelProvider {
  id        String   @id
  tenantId  String
  name      String
  kind      String
  model     String?
  endpoint  String?
  config    Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, kind, enabled])
}

model OrcfloTrigger {
  id          String   @id
  tenantId    String
  workflowId  String
  name        String
  kind        String
  config      Json
  enabled     Boolean  @default(true)
  lastFiredAt DateTime?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@index([tenantId, kind, enabled])
  @@index([tenantId, workflowId])
  @@index([tenantId, kind, name])
}

model OrcfloBlueprint {
  id          String   @id
  tenantId    String
  name        String
  description String   @default("")
  version     Int      @default(1)
  parameters  Json
  graph       Json
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, updatedAt])
}

# PostgreSQL 16 connection used by Prisma. Required only when ASE_PERSISTENCE_MODE=postgres.
DATABASE_URL="postgresql://ase:change-me@localhost:5432/ase_voxflow?schema=public"

# CI-only, disposable database used when diffing migration history against the schema.
# Never point this at an application or production database.
SHADOW_DATABASE_URL=""

# Demo mode accepts spoofable x-ase-* request headers and defaults. Any other value fails
# closed until trusted identity verification is implemented.
ASE_RUNTIME_MODE="demo"

# "memory" is explicitly ephemeral. "postgres" selects the Prisma/PostgreSQL adapters.
ASE_PERSISTENCE_MODE="memory"

# Deferred transport. No NATS adapter is currently implemented.
NATS_URL=""

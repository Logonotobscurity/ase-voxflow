# Ase / VOXFLOW — environment variables
#
# This file documents every env var the platform reads. Production
# deploys MUST override the demo defaults; see
# docs/ARCHITECTURE.md §3 and docs/security/accepted-risks.md.

# === Persistence ===

# PostgreSQL 16 connection used by Prisma. Required only when
# ASE_PERSISTENCE_MODE=postgres.
DATABASE_URL="postgresql://ase:change-me@localhost:5432/ase_voxflow?schema=public"

# CI-only, disposable database used when diffing migration history
# against the schema. Never point this at an application or
# production database.
SHADOW_DATABASE_URL=""

# "memory" is explicitly ephemeral. "postgres" selects the
# Prisma/PostgreSQL adapters. Any other value fails to boot.
ASE_PERSISTENCE_MODE="memory"


# === Runtime mode and identity (Audit §1) ===

# Demo mode accepts spoofable x-ase-* request headers and
# defaults. Any non-demo value requires ASE_PROD_BEARER_TOKEN
# and refuses to verify the spoofable header path.
ASE_RUNTIME_MODE="demo"

# Required when ASE_RUNTIME_MODE is not "demo". Must be at least
# 16 characters. Compare against the Authorization: Bearer header
# in constant time. The platform refuses to boot without it.
# Rotate via the deployment secret store; do not commit a real value.
# Example: ASE_PROD_BEARER_TOKEN="<set in your secret store>"


# === Outbox dispatcher (Audit §3) ===

# Worker id used to identify this process in the outbox.
# Default: outbox-worker-<pid>.
# ASE_OUTBOX_WORKER_ID=""

# Lease duration in milliseconds before another worker may reclaim
# a row whose owner crashed. Default: 30000.
# ASE_OUTBOX_LEASE_MS="30000"

# Interval between dispatcher ticks in milliseconds. Default: 1000.
# ASE_OUTBOX_TICK_INTERVAL_MS="1000"

# Maximum number of dispatch attempts before a row is moved to
# DEAD_LETTERED. Default: 5.
# ASE_OUTBOX_MAX_ATTEMPTS="5"


# === Durable run worker ===

# Worker id used to claim PENDING runs in the multi-worker claim/lease
# protocol (mirrors the outbox). Default: run-worker-<pid>.
# ASE_RUN_WORKER_ID=""

# Lease duration in milliseconds before another worker may reclaim a
# claimed run whose owner crashed. Default: 60000.
# ASE_RUN_LEASE_MS="60000"

# === Orcflo bridge ===

# Maximum recursion depth for AGENT -> WORKFLOW calls (a workflow tool
# invoked by an agent, which may contain agent nodes, which may invoke
# workflow tools again). Default: 3. Exceeding the limit fails the
# invocation with WORKFLOW_ERROR; no run is started.
# ASE_ORCFLO_TOOL_MAX_DEPTH="3"


# === Deferred transport ===

# No NATS adapter is currently implemented. The dispatcher uses a
# no-op publisher that records would-have-been dispatches. A real
# broker replaces the publisher at the composition root.
NATS_URL=""

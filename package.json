{
  "name": "ase-voxflow-platform",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=20.20 <23"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@xyflow/react": "^12.8.4",
    "dotenv": "17.2.3",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "^15.4.6",
    "pg": "8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "8.15.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.23",
    "prisma": "7.9.1",
    "tsx": "4.20.6",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  }
}
